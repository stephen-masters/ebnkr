{
  "name": "ebnkr",
  "version": "1.0.0",
  "description": "IBAN validation and formatting against ISO 13616 and the SWIFT IBAN Registry, with no runtime dependencies.",
  "private": true,
  "license": "MIT",
  "author": "Stephen Masters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephen-masters/ebnkr.git"
  },
  "keywords": [
    "iban",
    "iso-13616",
    "iso-7064",
    "mod-97",
    "banking",
    "validation"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && markdownlint-cli2",
    "lint:fix": "eslint . --fix && markdownlint-cli2 --fix",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.test.ts\"",
    "smoke": "node test/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run smoke",
    "registry": "node scripts/build-registry.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.24.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "markdown-it": "^15.0.3",
    "katex": "^0.19.1",
    "re2js": "^2.9.1",
    "smol-toml": "^1.8.1"
  }
}
